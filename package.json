{
  "name": "nihon-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "setup": "npm run db:prepare && npm run db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/import-japanese-curriculum.ts",
    "import:curriculum": "tsx scripts/import-japanese-curriculum.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.18.0",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "2.4.3",
    "gsap": "file:vendor/gsap",
    "next": "14.2.5",
    "next-auth": "4.24.7",
    "nodemailer": "^6.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.12",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
